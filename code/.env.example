# ProxyAPI (Claude + DALL-E)
PROXYAPI_KEY=sk-...

# Telegram (тот же бот, через который ходят остальные)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Модели
LLM_MODEL=claude-sonnet-4-5
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1792x1024

# Куки Дзена (экспорт из браузера в формате JSON Playwright storage_state)
DZEN_STATE_PATH=/opt/projects/blog_dzen/code/dzen_state.json

# Папка под обложки
IMAGES_DIR=/opt/projects/blog_dzen/images

# Расписание (информационно — реальный триггер в systemd timer)
SCHEDULE_DAYS=mon,wed,fri
SCHEDULE_TIME=10:00
